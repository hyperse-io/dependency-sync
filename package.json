{
  "name": "@hyperse/dependency-sync",
  "version": "1.1.1",
  "description": "A comprehensive Node.js utility for managing dependencies in monorepo environments, specifically designed for Hyperse plugin ecosystems.",
  "keywords": [
    "hyperse",
    "typescript",
    "monorepo",
    "dependency management"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/dependency-sync.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.build.json",
    "changeset": "changeset",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "cz": "cz",
    "g:checkConflicts": "yarn node --import=@hyperse/ts-node/register ./scripts/checkConflicts.ts",
    "g:syncDependencies": "yarn node --import=@hyperse/ts-node/register ./scripts/syncDependencies.ts && yarn constraints",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "lint-staged-files": "lint-staged --allow-empty",
    "next": "next build",
    "prepare": "husky",
    "release": "yarn build && changeset publish",
    "test": "run-s test-unit",
    "test-task": "vitest run",
    "test-unit": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "^6.x"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "globby": "^16.2.4",
    "sort-package-json": "^4.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^2.0.0",
    "@hyperse/ts-node": "^1.2.0",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
